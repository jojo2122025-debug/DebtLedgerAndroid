    "views": [
      {
        "viewName": "debt_balances",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT d.*, COALESCE(p.paidMinor, 0) AS paidMinor,\n       d.originalAmountMinor - COALESCE(p.paidMinor, 0) AS remainingMinor\nFROM debts d LEFT JOIN (\n    SELECT debtId, SUM(amountMinor) AS paidMinor\n    FROM payments WHERE voidedAt IS NULL GROUP BY debtId\n) p ON p.debtId = d.id"
      }
    ],
